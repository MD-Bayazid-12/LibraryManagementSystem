@{
    ViewData["Title"] = "Dashboard";
}

<div class="text-center">
    <h1 class="display-4">Library Management System</h1>
    <p class="lead">Manage students, books, and bookings efficiently</p>
</div>

<div class="row mt-4">
    <div class="col-md-3 mb-3">
        <div class="card bg-primary text-white">
            <div class="card-body text-center">
                <h3>@ViewBag.TotalStudents</h3>
                <p class="mb-0">Total Students</p>
                <i class="bi bi-people" style="font-size: 2rem;"></i>
            </div>
        </div>
    </div>

    <div class="col-md-3 mb-3">
        <div class="card bg-success text-white">
            <div class="card-body text-center">
                <h3>@ViewBag.TotalBooks</h3>
                <p class="mb-0">Total Books</p>
                <i class="bi bi-book" style="font-size: 2rem;"></i>
            </div>
        </div>
    </div>

    <div class="col-md-3 mb-3">
        <div class="card bg-info text-white">
            <div class="card-body text-center">
                <h3>@ViewBag.ActiveBookings</h3>
                <p class="mb-0">Active Bookings</p>
                <i class="bi bi-calendar-check" style="font-size: 2rem;"></i>
            </div>
        </div>
    </div>

    <div class="col-md-3 mb-3">
        <div class="card bg-danger text-white">
            <div class="card-body text-center">
                <h3>@ViewBag.OverdueBookings</h3>
                <p class="mb-0">Overdue Bookings</p>
                <i class="bi bi-exclamation-triangle" style="font-size: 2rem;"></i>
            </div>
        </div>
    </div>
</div>

<div class="row mt-4">
    <div class="col-md-6">
        <div class="card">
            <div class="card-header bg-primary text-white">
                <h5>Quick Actions</h5>
            </div>
            <div class="card-body">
                <div class="d-grid gap-2">
                    <a asp-controller="Student" asp-action="Create" class="btn btn-outline-primary">
                        <i class="bi bi-person-plus"></i> Add New Student
                    </a>
                    <a asp-controller="Book" asp-action="Create" class="btn btn-outline-success">
                        <i class="bi bi-plus-circle"></i> Add New Book
                    </a>
                    <a asp-controller="Booking" asp-action="Create" class="btn btn-outline-info">
                        <i class="bi bi-calendar-plus"></i> Create New Booking
                    </a>
                </div>
            </div>
        </div>
    </div>

    <div class="col-md-6">
        <div class="card">
            <div class="card-header bg-success text-white">
                <h5>Recent Activities</h5>
            </div>
            <div class="card-body">
                <ul class="list-group list-group-flush">
                    <li class="list-group-item d-flex justify-content-between align-items-center">
                        <i class="bi bi-arrow-right"></i> Latest bookings
                        <span class="badge bg-primary rounded-pill">View</span>
                    </li>
                    <li class="list-group-item d-flex justify-content-between align-items-center">
                        <i class="bi bi-arrow-right"></i> Due returns today
                        <span class="badge bg-warning rounded-pill">Check</span>
                    </li>
                    <li class="list-group-item d-flex justify-content-between align-items-center">
                        <i class="bi bi-arrow-right"></i> Pending payments
                        <span class="badge bg-danger rounded-pill">Action</span>
                    </li>
                </ul>
            </div>
        </div>
    </div>
</div>